{
  "redirects": [
    {
      "source": "/app",
      "destination": "https://app.doitforjesus.com/login",
      "permanent": false
    },
    {
      "source": "/app/:path*",
      "destination": "https://app.doitforjesus.com/login/prayer",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "doit4jesus.com" }],
      "destination": "https://www.doitforjesus.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.doit4jesus.com" }],
      "destination": "https://www.doitforjesus.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "doitforjesus.com" }],
      "destination": "https://www.doitforjesus.com/:path*",
      "permanent": true
    }
  ]
}
